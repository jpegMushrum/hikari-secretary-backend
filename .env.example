APP_ENV=development
HTTP_ADDRESS=:8080
SHUTDOWN_TIMEOUT=10s

POSTGRES_DB=hikari
POSTGRES_USER=hikari
POSTGRES_PASSWORD=change-me-for-local-development

DATABASE_URL=postgres://hikari:change-me-for-local-development@database:5432/hikari?sslmode=disable

# Значения нужны API для проверки Telegram Mini App и доступа администраторов.
# Не используйте этот примерный токен и не добавляйте реальный .env в Git.
TELEGRAM_BOT_TOKEN=replace-with-the-actual-bot-token
ADMIN_TELEGRAM_IDS=123456789
TELEGRAM_INIT_DATA_MAX_AGE=1h

# Отдельный длинный случайный секрет для запросов Python-бота к backend.
# Это не токен Telegram-бота и не должен совпадать с ним.
BOT_SERVICE_TOKEN=replace-with-a-long-random-service-secret

# Learning Content / DeepSeek: пустой ключ отключает генератор,
# настройки и история в Admin API остаются доступны.
# Production Compose передаёт параметры DEEPSEEK_*, AI_TOPIC_TARGET_KEY,
# AI_TOPIC_AUTO_PUBLISH_TIME и три AI_TOPIC_*_COUNT из корневого .env.
# AI_TOPIC_MAX_ATTEMPTS задаётся здесь, в backend/.env.
# Для включения укажите AI_TOPIC_TARGET_KEY из файла целей.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=90
AI_TOPIC_TARGET_KEY=
AI_TOPIC_AUTO_PUBLISH_TIME=
AI_TOPIC_QUESTION_COUNT=5
AI_TOPIC_VOCABULARY_COUNT=10
AI_TOPIC_GRAMMAR_COUNT=3
AI_TOPIC_MAX_ATTEMPTS=5
TIMEZONE=Europe/Moscow
REMINDER_OPTIONS_MINUTES=30,60,120,360,1440
# Telegram-контакт для первой регистрации участника вне ИТМО, например @club_admin.
FIRST_VISIT_ADMIN_USERNAME=
# При отдельном запуске укажите путь к файлу целей; Compose монтирует его сам.
TARGETS_PATH=/app/targets.json

# Shared with bot at the same filesystem path; retain uploaded admin media.
ADMIN_MEDIA_DIR=data/admin-media

# Shared bot photo directory for authenticated publication previews (optional).
# Default: /app/data/media; must match the bot's MEDIA_DIR.
# BOT_MEDIA_DIR=/app/data/media

# Private S3 for mascot concepts. Leave bucket empty to disable uploads.
# Production Compose supplies these settings from the optional mascot media env file.
MASCOT_S3_ENDPOINT=
MASCOT_S3_REGION=
MASCOT_S3_BUCKET=
MASCOT_S3_PREFIX=
MASCOT_S3_ACCESS_KEY_ID=
MASCOT_S3_SECRET_ACCESS_KEY=
