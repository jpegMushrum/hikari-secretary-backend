APP_ENV=development
HTTP_ADDRESS=:8080
SHUTDOWN_TIMEOUT=10s

POSTGRES_DB=hikari
POSTGRES_USER=hikari
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433

DATABASE_URL=postgres://hikari:change-me-for-local-development@database:5432/hikari?sslmode=disable
API_PORT=8080

# Значения нужны API для проверки Telegram Mini App и доступа администраторов.
# Не используйте этот примерный токен и не добавляйте реальный .env в Git.
TELEGRAM_BOT_TOKEN=replace-with-the-actual-bot-token
ADMIN_TELEGRAM_IDS=123456789
TELEGRAM_INIT_DATA_MAX_AGE=1h

# Отдельный длинный случайный секрет для запросов Python-бота к backend.
# Это не токен Telegram-бота и не должен совпадать с ним.
BOT_SERVICE_TOKEN=replace-with-a-long-random-service-secret
