FROM golang:1.27.3-alpine AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/import-legacy ./cmd/import-legacy

FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && addgroup -S hikari \
    && adduser -S -G hikari -h /app hikari
WORKDIR /app
COPY --from=build /out/import-legacy /app/import-legacy
USER hikari
ENTRYPOINT ["/app/import-legacy"]
